# ============================================================
# Multi-stage Dockerfile for Country Service (Spring Boot API)
# Security: Alpine base, non-root user, minimal JRE
# ============================================================

# ── Stage 1: Build ──────────────────────────────────────────
FROM maven:3.9-eclipse-temurin-17-alpine AS build

WORKDIR /app

# Copy pom.xml first for dependency caching
COPY country-service-main/pom.xml ./
COPY country-service-main/.mvn ./.mvn
COPY country-service-main/mvnw ./
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B

# Copy source and build (skip tests and checkstyle for container builds)
# Override java.version since source uses records (Java 16+)
COPY country-service-main/src ./src
RUN ./mvnw package -DskipTests -Dcheckstyle.skip=true -Djava.version=17 -Dmaven.compiler.source=17 -Dmaven.compiler.target=17 -B

# ── Stage 2: Production ────────────────────────────────────
FROM eclipse-temurin:17-jre-alpine AS production

# Security: Install only what's needed, remove package cache
RUN apk --no-cache add dumb-init

WORKDIR /app

# Security: Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Copy only the built JAR from build stage
COPY --from=build /app/target/*.jar app.jar

# Security: Set ownership and restrict file permissions
RUN chown appuser:appgroup app.jar && \
    chmod 400 app.jar

# Security: Run as non-root
USER appuser

# Expose port
EXPOSE 8081

# Health check — accepts any HTTP response (even 401) as proof server is running
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=5 \
    CMD wget --server-response --spider http://localhost:8081/ 2>&1 | grep -q 'HTTP' || exit 1

# Security: Use dumb-init to handle signals properly (prevents zombie processes)
ENTRYPOINT ["dumb-init", "--"]
CMD ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "app.jar", "--server.port=8081"]
